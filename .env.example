# Where Next forwards /api/* (the Python backend). Server-side only.
BACKEND_URL=http://localhost:8000
# This site's public origin; used to build the return_url sent to the auth site.
NEXT_PUBLIC_SITE_URL=https://pc.playnextai.com
# The shared sign-in site. We never implement sign-in here.
NEXT_PUBLIC_AUTH_URL=https://auth.playnextai.com
# PROVISIONAL until the SSO team publishes the platform contract (see lib/auth.ts).
# NEXT_PUBLIC_AUTH_LOGIN_PATH=/login
# NEXT_PUBLIC_AUTH_STEAM_PATH=/steam/login
