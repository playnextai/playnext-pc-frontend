# Where Next forwards /api/* (the Python backend). Server-side only.
BACKEND_URL=http://localhost:8000
# This site's public origin; used to build the PC callback (/auth/sso/callback) sent to Global Auth as return_url.
# Local work: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://pc.playnext.ir
# The Global Auth site. Sign-in, linking, account management and sign-out all live there; we never implement them.
# The paths (/login, /auth/steam/link, /auth/google/link, /auth/logout) are fixed by the contract.
NEXT_PUBLIC_AUTH_URL=https://auth.playnext.ir
